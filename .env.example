# ─────────────────────────────────────────────────────────────
# 개발자 PC 설정: 이 파일을 .env.local 로 복사해서 값을 채웁니다 (.env.local 은 커밋·배포되지 않음)
# 동기화 프로그램(npm run sync)과 개발자 명령(npm run cms:*, admin)이 사용합니다.
# ─────────────────────────────────────────────────────────────

# 홈페이지 주소
CMS_SITE_URL=https://www.chataekwondo.com

# 동기화 토큰 — Vercel 환경변수 CMS_SYNC_TOKEN 과 같은 값 (★ 비밀)
CMS_SYNC_TOKEN=

# 서버 자동 백업 복호화 키 — Vercel 환경변수 BACKUP_KEY 와 같은 값 (★ 비밀, npm run cms:backup -- --cloud 에 필요)
BACKUP_KEY=

# ─────────────────────────────────────────────────────────────
# 참고: Vercel 환경변수 (Vercel 대시보드에서 설정, 이 파일에 넣지 않음)
#   KV_REST_API_URL, KV_REST_API_TOKEN  ← Upstash Redis 연결 시 자동 생성
#   BLOB_READ_WRITE_TOKEN               ← Vercel Blob 연결 시 자동 생성
#   SESSION_SECRET                      ← 직접 생성 (32자 이상 임의 문자열)
#   CMS_SYNC_TOKEN                      ← 직접 생성 (32자 이상), 위와 같은 값
#   BACKUP_KEY                          ← 직접 생성 (32자 이상), 위와 같은 값
#   CRON_SECRET                         ← 직접 생성 (자동 백업 Cron 인증)
# 임의 문자열 만들기: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# ─────────────────────────────────────────────────────────────
